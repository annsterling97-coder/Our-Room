/* 页面整体容器 */
.container {
  padding: 30rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
  display:flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 文本输入框美化 */
.input-box {
  width: 100%;
  height: 300rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box; 
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

/* 发布按钮美化*/
.submit-btn {
  width: 100%;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 40rpx;
  font-weight: 500;
  font-size: 32rpx;
  padding: 20rpx 0;
  box-sizing: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

